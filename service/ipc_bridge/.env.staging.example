# Set the account for this environment before starting.
QMT_BRIDGE_HOST=
QMT_BRIDGE_PORT=8888
QMT_BRIDGE_ID=staging
QMT_BRIDGE_ACCOUNT_ID=
QMT_BRIDGE_REQUEST_TIMEOUT=10
QMT_BRIDGE_DOWNLOAD_TIMEOUT=120
QMT_BRIDGE_RECONCILE_INTERVAL_SECONDS=30
QMT_BRIDGE_LOG_LEVEL=INFO
QMT_BRIDGE_LOG_DIRECTORY=var/log/ipc_bridge/staging

# Leave all three empty for query-only mode. Existing schema must be installed.
QMT_BRIDGE_PG_HOST=127.0.0.1
QMT_BRIDGE_PG_PORT=5432
QMT_BRIDGE_PG_DATABASE=
QMT_BRIDGE_PG_USER=
QMT_BRIDGE_PG_PASSWORD=
